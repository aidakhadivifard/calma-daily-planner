# Copy this file to `.env` and fill in the values you have.
# Geero runs in mock mode (local auth + sample data) when these are left blank.

# Backend API base URL. Leave unset to use the Vite dev proxy at /api.
# VITE_API_BASE_URL=http://localhost:5050/api

# Firebase Auth (Google / Email / Phone sign-in)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
