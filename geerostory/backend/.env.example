# Copy this file to `.env` and fill in the values you have.
# Geero runs in mock mode (in-memory data, templated stories, silent audio,
# gradient covers, and a "simulate subscribe" button) for any service whose
# keys are left blank.

PORT=5050
CORS_ORIGIN=*
CLIENT_URL=http://localhost:5173

# Anthropic Claude — story text generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI — narration audio (TTS) and cover illustrations (DALL-E)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_IMAGE_MODEL=dall-e-3

# Firebase Admin — auth verification + Firestore storage
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Stripe — subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
